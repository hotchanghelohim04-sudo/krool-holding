# Copier ce fichier en `.env` (racine) pour Docker Compose,
# et/ou en `backend/.env` pour lancer Django hors Docker.
# NE JAMAIS committer le fichier .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Chemin de l'admin Django de secours (mettre une valeur non devinable en prod)
DJANGO_ADMIN_URL=django-admin/
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Proxys de confiance devant Django, pour lire la vraie IP (limitation de débit) :
# 1 en local (Next.js relaie /api), 1 avec Caddy seul, 2 avec Cloudflare + Caddy.
DRF_NUM_PROXIES=1
# Limite des formulaires publics par adresse IP
THROTTLE_LEADS=10/hour

# --- PostgreSQL ---
POSTGRES_DB=krool
POSTGRES_USER=krool
POSTGRES_PASSWORD=a-remplacer
# Hors Docker uniquement (dans Docker, l'URL est construite par docker-compose.yml)
DATABASE_URL=postgres://krool:a-remplacer@localhost:5432/krool

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- E-mails (Brevo ou Resend en prod ; console en dev = affichés dans les logs) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# En prod : EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend + paramètres SMTP
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Krool Holding <no-reply@krool-holding.com>
EMAIL_CONTACT=contact@krool-holding.com
EMAIL_SOLUTIONS=solutions@krool-holding.com
EMAIL_SUPPORT=support@krool-holding.com
# URL publique du site (liens dans les e-mails)
SITE_URL=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google reCAPTCHA v3 (formulaires publics) ---
# Clés à créer sur https://www.google.com/recaptcha/admin (type « reCAPTCHA v3 »,
# domaines : localhost + krool-holding.com). Vides = protection désactivée (dev).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score minimal accepté (0 = robot certain, 1 = humain certain)
RECAPTCHA_MIN_SCORE=0.5

# --- Production (profil « prod » de docker-compose) ---
SITE_DOMAIN=krool-holding.com
